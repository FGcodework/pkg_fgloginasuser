<?xml version="1.0" encoding="UTF-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_FGLOGINASUSER_LOGS_FILTER_SEARCH"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="client"
			type="list"
			label="COM_FGLOGINASUSER_COL_WHERE"
			class="js-select-submit-on-change"
			>
			<option value="">COM_FGLOGINASUSER_FILTER_CLIENT</option>
			<option value="site">COM_FGLOGINASUSER_CLIENT_SITE</option>
			<option value="administrator">COM_FGLOGINASUSER_CLIENT_ADMIN</option>
		</field>
		<field
			name="status"
			type="list"
			label="JSTATUS"
			class="js-select-submit-on-change"
			>
			<option value="">COM_FGLOGINASUSER_FILTER_STATUS</option>
			<option value="pending">COM_FGLOGINASUSER_STATUS_PENDING</option>
			<option value="active">COM_FGLOGINASUSER_STATUS_ACTIVE</option>
			<option value="ended">COM_FGLOGINASUSER_STATUS_ENDED</option>
			<option value="denied">COM_FGLOGINASUSER_STATUS_DENIED</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="fullordering"
			type="list"
			label="JGLOBAL_SORT_BY"
			class="js-select-submit-on-change"
			default="a.id DESC"
			validate="options"
			>
			<option value="">JGLOBAL_SORT_BY</option>
			<option value="a.created ASC">COM_FGLOGINASUSER_SORT_DATE_ASC</option>
			<option value="a.created DESC">COM_FGLOGINASUSER_SORT_DATE_DESC</option>
			<option value="a.actor_username ASC">COM_FGLOGINASUSER_SORT_ACTOR_ASC</option>
			<option value="a.actor_username DESC">COM_FGLOGINASUSER_SORT_ACTOR_DESC</option>
			<option value="a.target_username ASC">COM_FGLOGINASUSER_SORT_TARGET_ASC</option>
			<option value="a.target_username DESC">COM_FGLOGINASUSER_SORT_TARGET_DESC</option>
			<option value="a.id ASC">JGRID_HEADING_ID_ASC</option>
			<option value="a.id DESC">JGRID_HEADING_ID_DESC</option>
		</field>
		<field
			name="limit"
			type="limitbox"
			label="JGLOBAL_LIST_LIMIT"
			default="20"
			class="js-select-submit-on-change"
		/>
	</fields>
</form>
